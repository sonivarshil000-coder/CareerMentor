generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  PREMIUM
}

enum ResumeParseStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum AtsPlatform {
  GREENHOUSE
  LEVER
  ASHBY
  SMARTRECRUITERS
  WORKABLE
  GENERIC
  UNSUPPORTED
}

enum ApplicationStatus {
  FOUND
  NEEDS_APPROVAL
  NEEDS_USER_ACTION
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  FAILED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationKind {
  NEW_MATCHING_JOB
  NEEDS_APPROVAL
  APPLICATION_FAILURE
  SYSTEM
}

enum UsageAction {
  COMPANY_CREATED
  APPLICATION_CREATED
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  consentedAt       DateTime?
  consentVersion    String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  profile           Profile?
  answers           Answer[]
  resumes           Resume[]
  companies         Company[]
  matches           Match[]
  applications      Application[]
  auditEvents       AuditEvent[]
  notifications     Notification[]
  usageRecords      UsageRecord[]
  accounts          Account[]
  sessions          Session[]
  subscription      Subscription?
}

model Profile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  fullName               String?
  email                  String?
  phone                  String?
  city                   String?
  links                  Json     @default("[]")
  noticePeriod           String?
  expectedSalary         String?
  workAuthorization      String?
  needsVisaSponsorship   Boolean?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Answer {
  id        String   @id @default(cuid())
  userId    String
  question  String
  answer    String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Resume {
  id                String           @id @default(cuid())
  userId            String
  targetRole        String
  originalName      String
  mimeType          String
  objectKey         String           @unique
  contentHash       String
  parsedData        Json?
  parseStatus       ResumeParseStatus @default(PENDING)
  parseError        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches           Match[]
  applications      Application[]

  @@unique([userId, contentHash])
  @@index([userId, createdAt])
}

model Company {
  id               String      @id @default(cuid())
  userId           String
  name             String
  careersUrl       String
  normalizedUrl    String
  atsPlatform      AtsPlatform @default(UNSUPPORTED)
  roleKeywords     String[]    @default([])
  locations        String[]    @default([])
  discoveryEnabled Boolean     @default(true)
  lastScannedAt    DateTime?
  nextScanAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs             Job[]

  @@unique([userId, normalizedUrl])
  @@index([discoveryEnabled, nextScanAt])
}

model Job {
  id          String      @id @default(cuid())
  companyId   String
  source      AtsPlatform
  sourceId    String
  title       String
  location    String?
  employment  String?
  url         String
  description String
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  closedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matches     Match[]
  applications Application[]

  @@unique([companyId, source, sourceId])
  @@index([companyId, closedAt, lastSeenAt])
}

model Match {
  id              String   @id @default(cuid())
  userId          String
  jobId           String
  resumeId        String
  score           Int
  matchedSkills   String[] @default([])
  skillGaps       String[] @default([])
  explanation     String
  model           String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId, resumeId])
  @@index([userId, score, createdAt])
}

model Application {
  id                String            @id @default(cuid())
  userId            String
  jobId             String
  resumeId          String
  status            ApplicationStatus @default(FOUND)
  answersSnapshot   Json?
  submittedAt       DateTime?
  externalReference String?
  stopReason        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job               Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume            Resume            @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  approval          Approval?
  auditEvents       AuditEvent[]

  @@unique([userId, jobId])
  @@index([userId, status, updatedAt])
}

model Approval {
  id             String           @id @default(cuid())
  applicationId  String           @unique
  decision       ApprovalDecision @default(PENDING)
  proposedFields Json
  screenshotKey  String?
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  application    Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id            String       @id @default(cuid())
  userId        String
  applicationId String?
  eventType     String
  payload       Json
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([applicationId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String
  href      String?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model UsageRecord {
  id             String     @id @default(cuid())
  userId         String
  action         UsageAction
  quantity       Int        @default(1)
  periodStart    DateTime
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action, periodStart])
}

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  plan                   Plan     @default(FREE)
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?  @unique
  status                 String   @default("free")
  currentPeriodEnd       DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SignupConsent {
  email         String    @id
  consentedAt   DateTime  @default(now())
  consentVersion String
  expiresAt     DateTime
  consumedAt    DateTime?

  @@index([expiresAt, consumedAt])
}
