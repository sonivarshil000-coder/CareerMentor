# Web
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
DATABASE_URL=postgresql://applydesk:applydesk_dev@localhost:5432/applydesk?schema=public
REDIS_URL=redis://localhost:6379

# S3-compatible file storage (MinIO for local development)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=applydesk-private
S3_ACCESS_KEY=applydesk
S3_SECRET_KEY=applydesk_dev_secret_change_me
S3_FORCE_PATH_STYLE=true
FILE_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# AI
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Email notifications
EMAIL_SERVER=
EMAIL_FROM=ApplyDesk <notifications@localhost>
RESEND_API_KEY=

# Billing (configure only the provider(s) you enable)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
